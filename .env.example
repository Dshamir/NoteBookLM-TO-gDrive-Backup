# Copy to .env (nlm2drive.sh setup does this for you)

UI_PORT=8765
TZ=America/Toronto

# notebooklm-py version used by the host login helper (keep in sync with requirements.txt)
NOTEBOOKLM_PY_VERSION=0.8.4

# The archive destination (folder under "My Drive") is configured in the web UI → Settings.
# Default: NotebookLM/Archive  →  G:\My Drive\NotebookLM\Archive
